---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { client } from "@/lib/sanity";
import { isPublished } from "@/lib/content";
import { formatDate } from "@/lib/format";

type Issue = {
  slug: { current: string };
  title: string;
  issueNumber?: number;
  weekStart?: string;
  weekEnd?: string;
  publishDate?: string;
  expiryDate?: string;
  excerpt?: string;
  editor?: { name?: string; photoUrl?: string };
};

const issues = (
  await client.fetch<Issue[]>(
    `*[_type == "newsletter"]{
      slug, title, issueNumber, weekStart, weekEnd, publishDate, expiryDate, excerpt,
      "editor": editor->{name, photoUrl}
    } | order(coalesce(publishDate, weekStart) desc)`,
  ) || []
).filter((i) => isPublished(i.publishDate, i.expiryDate));
---

<BaseLayout
  title="Newsletter"
  description="Weekly newsletter from AlgoSoc: market notes, events, opportunities, and reads from Imperial College's algorithmic trading society."
  canonical="/newsletter"
>
  <div class="bg-brand-primary">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
      <h1 class="text-3xl sm:text-4xl font-bold text-brand-foreground">Newsletter</h1>
      <p class="mt-2 text-brand-foreground-muted max-w-xl">
        Weekly digest of market notes, upcoming events, opportunities, and curated reads.
      </p>

      {issues.length === 0 ? (
        <p class="mt-10 text-brand-foreground-muted">No issues yet. Check back soon.</p>
      ) : (
        <div class="mt-8 space-y-6">
          {issues.map((issue) => {
            const range = [issue.weekStart, issue.weekEnd]
              .filter(Boolean)
              .map((d) => formatDate(d as string))
              .join(" → ");
            return (
              <a
                href={`/newsletter/${issue.slug.current}`}
                class="group block bg-white/5 border border-white/10 rounded-xl p-6 hover:shadow-md hover:border-brand-accent/30 transition-all"
              >
                <div class="flex items-center gap-3 mb-2">
                  <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-amber-100 text-amber-700">
                    Newsletter
                  </span>
                  {typeof issue.issueNumber === "number" && (
                    <span class="text-xs text-brand-foreground-muted">Issue #{issue.issueNumber}</span>
                  )}
                  {range && (
                    <span class="text-xs text-brand-foreground-muted">{range}</span>
                  )}
                </div>
                <h2 class="text-lg font-semibold text-brand-foreground group-hover:text-brand-accent transition-colors">
                  {issue.title}
                </h2>
                {issue.excerpt && (
                  <p class="mt-2 text-sm text-brand-foreground-muted leading-relaxed">{issue.excerpt}</p>
                )}
                {issue.editor?.name && (
                  <p class="mt-3 text-xs text-brand-foreground-muted">Edited by {issue.editor.name}</p>
                )}
              </a>
            );
          })}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
