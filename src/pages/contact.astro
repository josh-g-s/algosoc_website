---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { client } from "@/lib/sanity";

const FALLBACK_EMAIL = "algo.trade@imperial.ac.uk";
const config = await client
  .fetch<{ contactEmail?: string } | null>(`*[_type == "siteConfig"][0]{ contactEmail }`)
  .catch(() => null);
// Only trust a plain address from the CMS (a pasted "mailto:" prefix is stripped);
// anything else, such as a query string or stray punctuation, uses the fallback.
const configured = config && !Array.isArray(config) ? config.contactEmail?.trim().replace(/^mailto:/i, "") : undefined;
const email = configured && /^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$/.test(configured) ? configured : FALLBACK_EMAIL;
---

<BaseLayout
  title="Contact"
  description="Get in touch with AlgoSoc, Imperial College's algorithmic trading society. Reach out for sponsorship, collaboration, or general enquiries."
  canonical="/contact"
>
  <div class="bg-brand-primary">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-2xl">
        <h1 class="text-3xl sm:text-4xl font-bold text-brand-foreground">
          Contact Us
        </h1>
        <p class="mt-2 text-brand-foreground-muted">
          Get in touch with the AlgoSoc committee. We&apos;d love to hear from you.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-center gap-3 text-brand-foreground">
            <svg class="w-5 h-5 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Imperial College London, South Kensington Campus, London SW7 2AZ</span>
          </div>
        </div>

        <div class="mt-10 rounded-xl border border-white/10 bg-white/5 p-6">
          <h2 class="text-xl font-bold text-brand-foreground">Email us</h2>
          <p class="mt-2 text-brand-foreground">
            For sponsorship, collaboration or general enquiries, send us an email and we will reply as soon as we can.
          </p>
          <p class="mt-4 text-lg font-semibold">
            <a href={`mailto:${email}`} class="text-brand-accent hover:underline">{email}</a>
          </p>
          <p class="mt-3 text-sm text-brand-foreground">
            If the link does not open your mail app, copy the address above into your email client or webmail.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
